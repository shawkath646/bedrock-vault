{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@electron/*": [
        "./electron/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
  },
  "include": [
    "src",
    "electron",
    "shared",
    "vite.config.ts"
  ]
}