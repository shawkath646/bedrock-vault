{
  "name": "bedrock-vault",
  "productName": "Bedrock Vault",
  "version": "1.0.3-beta",
  "description": "Cross-platform file encryption vault built with Electron, React Vite, AES-256-GCM, and Argon2.",
  "private": false,
  "type": "module",
  "main": "dist/main/main.js",
  "author": {
    "name": "Shawkat Hossain Maruf",
    "url": "https://shawkath646.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/shawkath646/bedrock-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawkath646/bedrock-vault.git"
  },
  "bugs": {
    "url": "https://github.com/shawkath646/bedrock-vault/issues",
    "email": "shawkath646@gmail.com"
  },
  "keywords": [
    "encryption",
    "cryptography",
    "electron",
    "react",
    "aes-gcm",
    "argon2",
    "security",
    "vault",
    "file-encryption"
  ],
  "scripts": {
    "install": "echo 'Skipped native addon compiling'",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "native:configure": "node-gyp configure",
    "native:build": "node-gyp build && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "native:rebuild": "node-gyp rebuild && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "electron": "electron .",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "piscina": "^5.2.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "systeminformation": "^5.31.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "node-addon-api": "^8.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "msw@2.14.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
