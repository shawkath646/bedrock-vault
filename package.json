{
  "name": "bedrock-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "install": "echo 'Skipped native addon compiling'",
    "dev": "vite",
    "build": "npx vite build",
    "main": "npx electron dist/main/main.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "native:configure": "npx node-gyp configure",
    "native:build": "npx node-gyp build && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "native:rebuild": "npx node-gyp rebuild && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "piscina": "^5.1.4",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "systeminformation": "^5.31.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.3.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "node-addon-api": "^8.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.0",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "msw@2.14.5": true
  }
}
