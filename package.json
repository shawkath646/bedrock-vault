{
  "name": "bedrock-vault",
  "productName": "Bedrock Vault",
  "version": "1.0.1-beta",
  "description": "Cross-platform file encryption vault built with Electron, React Vite, AES-256-GCM, and Argon2.",
  "private": false,
  "type": "module",
  "main": "dist/main/main.js",
  "author": {
    "name": "Shawkat Hossain Maruf",
    "url": "https://shawkath646.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/shawkath646/bedrock-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawkath646/bedrock-vault.git"
  },
  "bugs": {
    "url": "https://github.com/shawkath646/bedrock-vault/issues",
    "email": "shawkath646@gmail.com"
  },
  "keywords": [
    "encryption",
    "cryptography",
    "electron",
    "react",
    "aes-gcm",
    "argon2",
    "security",
    "vault",
    "file-encryption"
  ],
  "scripts": {
    "install": "echo 'Skipped native addon compiling'",
    "dev": "vite",
    "build": "npx vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "native:configure": "npx node-gyp configure",
    "native:build": "npx node-gyp build && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "native:rebuild": "npx node-gyp rebuild && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist/native | Out-Null; Copy-Item build/Release/native_prompt.node dist/native/native_prompt.node -Force\"",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "piscina": "^5.1.4",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "systeminformation": "^5.31.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.3.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "node-addon-api": "^8.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.0",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "msw@2.14.5": true
  }
}